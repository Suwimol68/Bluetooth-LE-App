{
  "expo": {
    "name": "Bluetooth LE App",
    "slug": "scan-ble",
    "version": "1.0.0",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanble",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.soradech.scanble"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F1E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Bluetooth LE App needs Bluetooth to connect to your classroom device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc2b5910-2ece-444f-8cbf-5e42c7e1752c"
      }
    },
    "owner": "suwimol-68"
  }
}
